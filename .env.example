# Run `npm run db:start`, then `npm run db:env` to generate .env.local.
# Keep the real .env.local ignored. Only the public key belongs in the app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
WYP_DEPLOYMENT_MODE=local

# Hosted ONLY: replace the three public values above with the matching project/HTTPS origin.
# Keep these server settings and all real credentials in the provider environment, not Git.
# WYP_DEPLOYMENT_MODE=hosted
# WYP_RELEASE_ENVIRONMENT=preview
# WYP_SUPABASE_PROJECT_REF=replace-with-project-reference
# WYP_SUPPORT_EMAIL=replace-with-monitored-support-address
# WYP_TURNSTILE_SITE_KEY=replace-with-real-public-widget-key
# Configure SMTP credentials and the Turnstile SECRET directly in Supabase Auth.
# Never give the web app a database password, service-role key or hosted maintenance token.
