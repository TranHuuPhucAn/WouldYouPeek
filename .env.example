# Run `npm run db:start`, then `npm run db:env` to generate .env.local.
# Keep the real .env.local ignored. Only the public key belongs in the app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
